.{
    .id = "dev.native_sdk.ai-souls",
    // `name` is the binary and the on-disk identity; `display_name` is
    // what a person sees.
    .name = "ai-souls",
    .display_name = "AI Souls",
    .description = "Dark Souls screens for your coding agent.",
    .version = "0.4.1",
    .icons = .{"assets/icon.png"},
    .platforms = .{ "macos", "windows", "linux" },
    .permissions = .{"view"},
    // No tray: nothing survives a screen, so a status item would appear
    // for the 2.6 seconds a banner is up and vanish with it.
    .capabilities = .{ "native_views", "gpu_surfaces" },
    .shell = .{
        .windows = .{
            // The banner IS the app's one window. The host creates it
            // from this declaration before any app code runs, ordered
            // out until its first frame has rendered — so nothing ever
            // flashes on screen but the banner itself. The size here is
            // nominal: the scene re-declares it against the real
            // display, and `overlay_style` places it (no host applies a
            // declared position — see `main.bandFrame`).
            .{
                .label = "main",
                .title = "AI Souls Screen",
                .width = 1440,
                .height = 260,
                .resizable = false,
                .restore_state = false,
                // No caption, no frame — Windows also requires a
                // chromeless style before it accepts a transparent
                // surface.
                .titlebar = "chromeless",
                // The band floats over the desktop; the premultiplied
                // alpha mode below is the other half of that.
                .transparent = true,
                .always_on_top = true,
                // The whole point: clicks land on whatever is under it.
                .click_through = true,
                // Never take the keyboard. A banner appearing over the
                // editor you are typing into must not steal focus, and
                // this window exists in every process of this binary.
                .activate_on_show = false,
                .close_policy = "quit",
                .views = .{
                    .{ .label = "overlay-canvas", .kind = "gpu_surface", .fill = true, .role = "Banner", .accessibility_label = "AI Souls screen", .gpu_pixel_format = "bgra8_unorm", .gpu_present_mode = "timer", .gpu_alpha_mode = "premultiplied", .gpu_color_space = "srgb", .gpu_vsync = true },
                },
            },
        },
    },
    // No WebViews anywhere in this app, but the Windows host gates
    // runtime-created native views (the overlay's canvas) on the system
    // engine being selected — dropping this leaves the overlay window
    // created but view-less, and therefore never shown.
    .web_engine = "system",
    .security = .{
        .navigation = .{
            .allowed_origins = .{ "zero://app", "zero://inline" },
            .external_links = .{ .action = "deny" },
        },
    },
}
