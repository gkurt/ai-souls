.{
    .id = "dev.native_sdk.ai-souls",
    // `name` is the binary and the on-disk identity; `display_name` is
    // what a person sees.
    .name = "ai-souls",
    .display_name = "AI Souls",
    .description = "Dark Souls screens for your coding agent.",
    .version = "0.3.1",
    .icons = .{"assets/icon.png"},
    .platforms = .{ "macos", "windows", "linux" },
    .permissions = .{ "view", "command" },
    // No tray: nothing survives a screen, so a status item would appear
    // for the 2.6 seconds a banner is up and vanish with it.
    .capabilities = .{ "native_views", "gpu_surfaces" },
    .shell = .{
        .windows = .{
            .{
                .label = "main",
                .title = "AI Souls",
                .width = 900,
                .height = 640,
                .min_width = 780,
                .min_height = 520,
                .restore_state = false,
                .restore_policy = "center_on_primary",
                // Nothing this app opens may take the keyboard. This
                // window is created in EVERY process, including the ones
                // that exist only to flash a banner — and its reveal
                // activating the app is how a hook used to steal focus
                // from whatever you were typing into. The cost is that
                // `ai-souls settings` opens unfocused; click it once.
                .activate_on_show = false,
                // Closing the settings window ends the process. There is
                // nothing for it to go on doing.
                .close_policy = "quit",
                .views = .{
                    .{ .label = "settings-canvas", .kind = "gpu_surface", .fill = true, .role = "Settings canvas", .accessibility_label = "AI Souls settings", .gpu_pixel_format = "bgra8_unorm", .gpu_present_mode = "timer", .gpu_alpha_mode = "opaque", .gpu_color_space = "srgb", .gpu_vsync = true },
                },
            },
        },
    },
    // No WebViews anywhere in this app, but the Windows host gates
    // runtime-created native views (the overlay's canvas) on the system
    // engine being selected — dropping this leaves the overlay window
    // created but view-less, and therefore never shown.
    .web_engine = "system",
    .security = .{
        .navigation = .{
            .allowed_origins = .{ "zero://app", "zero://inline" },
            .external_links = .{ .action = "deny" },
        },
    },
}
